# ============================================================
# stilo-agents — .gitignore
# Ignora tudo que é runtime/dados locais.
# Versiona apenas código-fonte do agente.
# ============================================================

# ---- Backups locais ----------------------------------------------------------
.backups/
*.bak
*.bak-*
*.bak.*
*.backup
*.backup.*

# ---- Configuração e segredos locais -----------------------------------------
.env
.env.*
!.env.example
config.yaml.bak*
SOUL.md
AGENTS.md
*.local.yaml

# ---- Runtime do agente -------------------------------------------------------
spawn-ledger.json
source-checks/
installs/
sessions/
logs/
checkpoints/
cron/
kanban/
tmp/
run/

# ---- Skills: estado e caches (mas versiona o conteúdo das skills) -----------
skills/.curator_backups/
skills/.usage.json
skills/.usage.json.lock
skills/**/.cache/
skills/**/__pycache__/

# ---- Tools baixadas automaticamente -----------------------------------------
tools/
!tools/.gitkeep
tools/.install.lock
tools/facts.json

# ---- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/
.venv/
venv/
env/
ENV/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/

# ---- Editores e OS ----------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---- Scripts e arquivos pessoais do usuário ---------------------------------
CreAltMd.py
ScriptSqlServer.md.*
ScriptsSql.md.*
v2.sql.*
*.sql.work
*.sql.edit
*.sql.aliases
*.sql.case2
*.sql.words
*.sql.final_words
*.md.work
*.md.edit
*.md.aliases
*.md.case2
*.md.words
*.md.final_words
*.md.rules

# ---- Caches diversos --------------------------------------------------------
.cache/
*.log
*.pid
*.sock
